# 真实配置与密钥 —— 绝不入库（见 docs/规范-脱敏.md）

# 本机真实配置（由 ops.conf.example 复制而来）
ops.conf
*.conf
!*.conf.example

# 环境变量 / 密钥 / 证书
*.env
*.env.*
*secret*
*token*
*ghtoken*
*password*
*passphrase*
*credential*
*.key
*.pem
*.p12
*.pfx
*.der
*.crt
*.cer
id_rsa*
id_ed25519*
*.kdbx
authorized_keys
known_hosts
.ssh/

# 签名产物与证书描述文件（可能内嵌令牌/私钥，属高危）
*.shortcut
*.mobileconfig
*.plist
*.ipa
*.apk

# 运行时产物与备份
*.log
logs/
backups/
backup/
*.bak
*.bak.*
*.bak-*
*.orig
*.tmp
*.tar
*.tar.gz
*.tar.zst
*.tgz
*.zip
*.gpg
*.sql
*.dump

# 状态与缓存目录
state/
var/
*.last-good
*.trail
__pycache__/
.venv/
node_modules/
.DS_Store
